# WellMate backend environment template.
# Copy to .env and fill in real values. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env

# --- Server ---
PORT=5000
NODE_ENV=development
# Exact origin of the frontend dev server. CORS allows only this value.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wellmate?retryWrites=true&w=majority

# --- Firebase Admin SDK (verifies frontend ID tokens) ---
# From the service account JSON in Firebase console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key in double quotes, keeping the literal \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Groq (intent extraction, backend only) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Sarvam AI (speech-to-text and text-to-speech, backend only) ---
SARVAM_API_KEY=
# Model names still to be confirmed against Sarvam's current docs (open decision 4).
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=

# --- Resend (email alerts to family) ---
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
RESEND_FROM_EMAIL=
