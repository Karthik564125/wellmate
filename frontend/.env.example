# WellMate frontend environment template.
# Copy to .env and fill in real values. Never commit .env (it is already
# gitignored, same as backend/.env).
#   PowerShell:  Copy-Item .env.example .env
#
# Vite only exposes variables prefixed VITE_ to browser code via
# import.meta.env.VITE_SOMETHING - everything here is meant to be public
# (Firebase's web config is not a secret; it identifies the project, it
# doesn't authenticate as it), unlike backend/.env.

# --- Firebase web app config ---
# Firebase Console -> Project settings (gear icon) -> General tab ->
# "Your apps" -> the web app (add one with the </> icon if none exists yet).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Backend API ---
# Base URL the frontend calls; everything is mounted under /api/v1.
VITE_API_BASE_URL=http://localhost:5000/api/v1
